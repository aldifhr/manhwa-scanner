# ── Backend connection ─────────────────────────────────────────────────────
# Server-only runtime env — the PRIMARY knob for the backend API base.
# Server-side API routes (lib/server-api.ts backendUrl()) resolve it first;
# client bundles cannot read it.
BACKEND_URL=https://scanner.aldifhr.fun

# Backend API auth token — sent as `Authorization: Bearer *** when no
# dashboard session cookie is present (lib/server-api.ts authHeaders()).
# DO NOT use a real/guessable value here. Leave empty and set the real
# secret via Vercel project env vars or your deployment environment.
API_TOKEN=

# Build-time fallback for the backend base URL, inlined into client bundles.
# Only used when BACKEND_URL is unset AND this is not a localhost address.
# NEXT_PUBLIC_API_BASE=https://scanner.aldifhr.fun

# RSS API URL (defaults to the backend's /api/rss)
# RSS_API_URL=https://scanner.aldifhr.fun/api/rss

# ── FastCron (dashboard snapshot refresh trigger) ─────────────────────────
# Shared secret that authenticates external cron webhooks hitting /api/cron.
# FastCron should call /api/cron?action=update&key=<CRON_SECRET>. The in-app
# "Sync Now" button passes the session cookie instead, so it needs no key.
# If unset, cron still requires a valid dashboard session cookie.
CRON_SECRET=change-me
# FASTCRON_API_KEY = token API FastCron (https://www.fastcron.com/account) untuk FE ambil data FastCron lewat /api/fastcron (cron_list/run/logs).
# BUKAN webhook secret — webhook secret cuma CRON_SECRET. Jangan samakan.
# Contoh rotasi webhook: CRON_SECRET=Fo-KeQ3...,rbwsSD... → FastCron ?key= boleh pakai salah satu.
# FASTCRON_API_KEY=your-fastcron-api-token
# FASTCRON_CRON_ID=19650525

# NOTE: AUTH_SECRET is BACKEND-only (HS256 JWT signing). The FE never reads it —
# lib/auth.ts only checks JWT expiry client-side; the backend re-validates via
# the ikiru_dashboard_session cookie on every proxied call.
