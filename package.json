{
  "name": "manhwa-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev:frontend": "pnpm --filter manhwa-reader dev",
    "dev:backend": "echo \"backend: cd apps/backend && uv run uvicorn app.main:app --reload\"",
    "dev": "pnpm --filter manhwa-reader dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --filter manhwa-reader test"
  }
}
