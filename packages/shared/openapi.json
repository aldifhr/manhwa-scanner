    "/api/reader/cover": {
      "get": {
        "summary": "Reader Cover",
        "description": "Authed cover endpoint (BE-3c/d).\n\nReturns the series cover image bytes WITHOUT exposing any S3/MinIO\npresigned URL in the API response. The client requests\n`/api/reader/cover?series=<slug>`; we resolve the real cover URL from\nthe DB (whitelist, then recent_chapters), scrub any AWS presign query\nparams, and proxy the image server-side. Short TTL cache headers.",
        "operationId": "reader_cover_api_reader_cover_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/reader/cover-img": {
      "get": {
        "summary": "Reader Cover Public",
        "description": "Public (unauthenticated) cover-image proxy for Discord embeds.\n\nDiscord's embed image fetcher cannot send our monitor auth token, so the\nauthenticated /reader/proxy returns 401 and covers render blank. This\nendpoint serves the same allowlisted, size-capped, cached image bytes but\nWITHOUT auth \u2014 safe because it only ever returns image data for a fixed\nhost allowlist (never arbitrary URLs), so it cannot be abused as an open\nproxy.",
        "operationId": "reader_cover_public_api_reader_cover_img_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
